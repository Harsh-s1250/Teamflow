# Copy this file to .env (or export these as real environment variables)
# for local development. NEVER commit an actual .env file.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/teamflow
DB_USERNAME=teamflow
DB_PASSWORD=change-me

# --- JWT ---
# Must be at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-value-min-32-bytes
JWT_EXPIRATION_MS=3600000

# --- Server / CORS ---
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO
